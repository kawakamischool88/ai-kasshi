# ------------------------------------------------------------
# アプリ本体が使う値（.env.local に写して使う）
# ブラウザにも配られる公開用の値だけを置く。service_role は置かない。
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=（Supabase の Project Settings → API Keys の anon / publishable キー）

# AIカッシー専用の Anthropic APIキー。既存事業（大仏ノート等）のキーは使わない。
# サーバー側だけで使う値。NEXT_PUBLIC_ を付けないこと（付けるとブラウザへ配られる）
ANTHROPIC_API_KEY=（Anthropic Console で作った AIカッシー専用のキー）

# 原価の安全装置（1か月・USD）。省略すると 警告15 / 停止40
# AI_MONTHLY_WARNING_USD=15
# AI_MONTHLY_STOP_USD=40

# ------------------------------------------------------------
# テスト・スクリプト専用の値（.env.test.local に写して使う）
# ここだけ service_role を使う。アプリ本体からは読まない。
# 開発用 Supabase の値だけを入れること。本番の値を入れない。
# ------------------------------------------------------------
SEED_TARGET=dev
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=（上と同じ anon キー）
SUPABASE_SERVICE_ROLE_KEY=（Project Settings → API Keys の service_role / secret キー）
TEST_USER_A_PASSWORD=（テスト専用の適当な文字列。8文字以上）
TEST_USER_B_PASSWORD=（テスト専用の適当な文字列。8文字以上）
